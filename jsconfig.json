{
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "vite.config.js",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true
  }
}
